+class TestStorageProfileSnapshotClassFallback:
+    """
+    Tests for fallback behavior when StorageProfile has no snapshotClass set.
+
+    Preconditions:
+        - Snapshot-capable storage class available on the cluster
+        - StorageProfile does NOT have snapshotClass configured
+        - VolumeSnapshotClass with matching provisioner driver exists
+        - Running VM created using the storage class with a data volume
+    """
+
+    @pytest.mark.polarion("CNV-61266")
+    def test_vm_snapshot_falls_back_to_default_selection(
+        self,
+        admin_client,
+        namespace,
+        snapshot_test_vm,
+        offline_vm_snapshot,
+        volume_snapshot_class_for_sc,
+    ):
+        """
+        Test that VM snapshot falls back to default VolumeSnapshotClass selection
+        when StorageProfile has no snapshotClass configured.
+
+        Steps:
+            1. Create a VMSnapshot from the running VM
+            2. Wait for the VMSnapshot to reach ready state
+            3. Retrieve the VolumeSnapshot created by the VMSnapshot
+            4. Read the volumeSnapshotClassName from the VolumeSnapshot spec
+
+        Expected:
+            - VolumeSnapshot's volumeSnapshotClassName equals the default
+              VolumeSnapshotClass for the storage provisioner
+        """
+        expected_vsc_name = volume_snapshot_class_for_sc.name
+        volume_snapshots = list(VolumeSnapshot.get(
+            namespace=namespace.name,
+            client=admin_client,
+        ))
+        assert volume_snapshots, "No VolumeSnapshots found in namespace after VMSnapshot creation"
+        for volume_snapshot in volume_snapshots:
+            actual_vsc_name = volume_snapshot.instance.spec.get("volumeSnapshotClassName")
+            LOGGER.info(
+                f"VolumeSnapshot '{volume_snapshot.name}' uses VolumeSnapshotClass '{actual_vsc_name}'"
+            )
+            assert actual_vsc_name == expected_vsc_name, (
+                f"VolumeSnapshot '{volume_snapshot.name}' uses VolumeSnapshotClass '{actual_vsc_name}', "
+                f"expected '{expected_vsc_name}' from default provisioner-matched selection"
+            )
+
+
+@pytest.mark.usefixtures("storage_profile_with_snapshot_class")
+class TestSnapshotRestoreCycleWithStorageProfileSnapshotClass:
+    """
+    Tests for end-to-end snapshot and restore cycle verifying data integrity
+    when StorageProfile snapshotClass is configured.
+
+    Preconditions:
+        - Snapshot-capable storage class available on the cluster
+        - StorageProfile configured with a specific snapshotClass value
+        - Running VM created using the storage class with a data volume
+        - File "pre-snapshot.txt" with content "before-snapshot" written to VM
+        - VMSnapshot created from the VM and in ready state
+        - File "post-snapshot.txt" with content "after-snapshot" written to VM
+          (after snapshot creation)
+        - VM stopped, restored from the snapshot, started, running, and SSH accessible
+    """
+
+    @pytest.mark.polarion("CNV-61266")
+    def test_pre_snapshot_file_preserved_after_restore(
+        self,
+        restored_vm_after_snapshot,
+    ):
+        """
+        Test that files created before the snapshot are preserved after restore.
+
+        Steps:
+            1. Read file pre-snapshot.txt from the restored VM via SSH
+
+        Expected:
+            - File content equals "before-snapshot"
+        """
+        output = run_ssh_commands(
+            host=restored_vm_after_snapshot.ssh_exec,
+            commands=shlex.split("cat pre-snapshot.txt"),
+        )[0].strip()
+        assert output == "before-snapshot", (
+            f"Pre-snapshot file content mismatch: expected 'before-snapshot', got '{output}'"
+        )
+
+    @pytest.mark.polarion("CNV-61266")
+    def test_post_snapshot_file_removed_after_restore(
+        self,
+        restored_vm_after_snapshot,
+    ):
+        """
+        Test that files created after the snapshot are removed after restore.
+
+        Steps:
+            1. Check if file post-snapshot.txt exists on the restored VM via SSH
+
+        Expected:
+            - File post-snapshot.txt does NOT exist
+        """
+        output = run_ssh_commands(
+            host=restored_vm_after_snapshot.ssh_exec,
+            commands=shlex.split(
+                f"bash -c {shlex.quote('test -f post-snapshot.txt && echo exists || echo missing')}"
+            ),
+        )[0].strip()
+        assert output == "missing", (
+            "File post-snapshot.txt should not exist after restore, but it was found"
+        )
