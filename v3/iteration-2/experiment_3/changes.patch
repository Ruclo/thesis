+"""
+VMI Hard Reset Tests
+
+STP Reference: /home/fedora/thesis/stps/3.md
+Jira: VIRTSTRAT-357
+
+This module contains tests for the VMI hard reset (force reset) functionality,
+which allows resetting a hung or unresponsive VirtualMachineInstance without
+pod rescheduling. The reset is analogous to the `virsh reset` command in libvirt.
+"""
+
+import logging
+
+import pytest
+from kubernetes.client.exceptions import ApiException
+from ocp_resources.virtual_machine_instance import VirtualMachineInstance
+
+from utilities.constants import TIMEOUT_10MIN
+from utilities.infra import run_virtctl_command
+from utilities.virt import (
+    VirtualMachineForTests,
+    fedora_vm_body,
+    get_vm_boot_time,
+    running_vm,
+    wait_for_running_vm,
+)
+
+LOGGER = logging.getLogger(__name__)
+
+
+@pytest.fixture(scope="class")
+def hard_reset_vm(namespace, unprivileged_client):
+    name = "hard-reset-vm"
+    with VirtualMachineForTests(
+        client=unprivileged_client,
+        name=name,
+        namespace=namespace.name,
+        body=fedora_vm_body(name=name),
+    ) as vm:
+        running_vm(vm=vm)
+        yield vm
+
+
+@pytest.fixture(scope="class")
+def boot_time_before_reset(hard_reset_vm):
+    return get_vm_boot_time(vm=hard_reset_vm)
+
+
+@pytest.fixture(scope="class")
+def vmi_uid_before_reset(hard_reset_vm):
+    return hard_reset_vm.vmi.instance.metadata.uid
+
+
+@pytest.fixture(scope="class")
+def virt_launcher_pod_name_before_reset(hard_reset_vm):
+    return hard_reset_vm.vmi.virt_launcher_pod.name
+
+
+@pytest.fixture(scope="class")
+def api_reset_and_running(hard_reset_vm):
+    LOGGER.info(f"Performing hard reset on VMI {hard_reset_vm.vmi.name} via API")
+    hard_reset_vm.vmi.reset()
+    wait_for_running_vm(vm=hard_reset_vm, ssh_timeout=TIMEOUT_10MIN)
+
+
+@pytest.fixture(scope="class")
+def virtctl_reset_vm(namespace, unprivileged_client):
+    name = "virtctl-reset-vm"
+    with VirtualMachineForTests(
+        client=unprivileged_client,
+        name=name,
+        namespace=namespace.name,
+        body=fedora_vm_body(name=name),
+    ) as vm:
+        running_vm(vm=vm)
+        yield vm
+
+
+@pytest.fixture(scope="class")
+def boot_time_before_virtctl_reset(virtctl_reset_vm):
+    return get_vm_boot_time(vm=virtctl_reset_vm)
+
+
+@pytest.fixture(scope="class")
+def virtctl_reset_and_running(virtctl_reset_vm):
+    LOGGER.info(f"Performing hard reset on VMI {virtctl_reset_vm.vmi.name} via virtctl")
+    command_success, _, error = run_virtctl_command(
+        command=["reset", virtctl_reset_vm.vmi.name],
+        namespace=virtctl_reset_vm.namespace,
+        verify_stderr=False,
+    )
+    assert command_success, f"virtctl reset command failed: {error}"
+    wait_for_running_vm(vm=virtctl_reset_vm, ssh_timeout=TIMEOUT_10MIN)
+
+
+@pytest.fixture(scope="class")
+def stopped_vm(namespace, unprivileged_client):
+    name = "stopped-reset-vm"
+    with VirtualMachineForTests(
+        client=unprivileged_client,
+        name=name,
+        namespace=namespace.name,
+        body=fedora_vm_body(name=name),
+    ) as vm:
+        running_vm(vm=vm)
+        LOGGER.info(f"Stopping VM {vm.name} for negative reset test")
+        vm.stop(wait=True)
+        yield vm
+
+
+@pytest.fixture(scope="class")
+def paused_vm(namespace, unprivileged_client):
+    name = "paused-reset-vm"
+    with VirtualMachineForTests(
+        client=unprivileged_client,
+        name=name,
+        namespace=namespace.name,
+        body=fedora_vm_body(name=name),
+    ) as vm:
+        running_vm(vm=vm)
+        LOGGER.info(f"Pausing VMI {vm.vmi.name} for reset test")
+        vm.vmi.pause(wait=True)
+        yield vm
+
+
+class TestVMIResetViaAPI:
+    """
+    Tests for VMI reset via the subresource API.
+
+    Preconditions:
+        - Running VMI with SSH access
+        - VMI UID recorded before reset
+        - Virt-launcher pod name recorded before reset
+        - Guest boot time recorded before reset
+        - VMI reset performed via subresource API (/virtualmachineinstances/{name}/reset)
+        - VMI is Running and SSH accessible after reset
+    """
+
+    @pytest.mark.polarion("CNV-12374")
+    def test_guest_accessible_after_api_reset(
+        self,
+        hard_reset_vm,
+        boot_time_before_reset,
+        vmi_uid_before_reset,
+        virt_launcher_pod_name_before_reset,
+        api_reset_and_running,
+    ):
+        """
+        Test that the VMI is Running and the guest is accessible after a hard reset via the API.
+
+        Steps:
+            1. Verify VMI status is Running and SSH connection succeeds after reset
+
+        Expected:
+            - VMI is "Running"
+        """
+        assert hard_reset_vm.vmi.status == VirtualMachineInstance.Status.RUNNING, (
+            f"VMI is not Running after reset, status: {hard_reset_vm.vmi.status}"
+        )
+
+    @pytest.mark.polarion("CNV-12375")
+    def test_vmi_uid_unchanged_after_reset(
+        self,
+        hard_reset_vm,
+        boot_time_before_reset,
+        vmi_uid_before_reset,
+        virt_launcher_pod_name_before_reset,
+        api_reset_and_running,
+    ):
+        """
+        Test that VMI UID remains unchanged after a hard reset.
+
+        Steps:
+            1. Compare VMI UID before and after reset
+
+        Expected:
+            - VMI UID after reset equals VMI UID before reset
+        """
+        uid_after_reset = hard_reset_vm.vmi.instance.metadata.uid
+        assert uid_after_reset == vmi_uid_before_reset, (
+            f"VMI UID changed after reset: before={vmi_uid_before_reset}, after={uid_after_reset}"
+        )
+
+    @pytest.mark.polarion("CNV-12376")
+    def test_pod_not_rescheduled_after_reset(
+        self,
+        hard_reset_vm,
+        boot_time_before_reset,
+        vmi_uid_before_reset,
+        virt_launcher_pod_name_before_reset,
+        api_reset_and_running,
+    ):
+        """
+        Test that the virt-launcher pod is not rescheduled after a hard reset.
+
+        Steps:
+            1. Compare virt-launcher pod name before and after reset
+
+        Expected:
+            - Virt-launcher pod name after reset equals pod name before reset
+        """
+        pod_name_after_reset = hard_reset_vm.vmi.virt_launcher_pod.name
+        assert pod_name_after_reset == virt_launcher_pod_name_before_reset, (
+            f"Virt-launcher pod changed after reset: before={virt_launcher_pod_name_before_reset}, "
+            f"after={pod_name_after_reset}"
+        )
+
+    @pytest.mark.polarion("CNV-12377")
+    def test_boot_time_changes_after_reset(
+        self,
+        hard_reset_vm,
+        boot_time_before_reset,
+        vmi_uid_before_reset,
+        virt_launcher_pod_name_before_reset,
+        api_reset_and_running,
+    ):
+        """
+        Test that the guest boot time changes after a hard reset, confirming guest reboot.
+
+        Steps:
+            1. Compare guest boot time before and after reset
+
+        Expected:
+            - Guest boot time after reset does not equal boot time before reset
+        """
+        boot_time_after_reset = get_vm_boot_time(vm=hard_reset_vm)
+        assert boot_time_after_reset != boot_time_before_reset, (
+            f"Boot time did not change after reset: before={boot_time_before_reset}, after={boot_time_after_reset}"
+        )
+
+
+class TestVMIResetViaVirtctl:
+    """
+    Tests for VMI reset via the virtctl CLI command.
+
+    Preconditions:
+        - Running VMI with SSH access
+        - Guest boot time recorded before reset
+    """
+
+    @pytest.mark.polarion("CNV-12378")
+    def test_virtctl_reset_reboots_guest(
+        self,
+        virtctl_reset_vm,
+        boot_time_before_virtctl_reset,
+        virtctl_reset_and_running,
+    ):
+        """
+        Test that the virtctl reset command successfully resets the guest.
+
+        Steps:
+            1. Execute `virtctl reset <vmi-name>` command
+            2. Wait for VMI to be Running and SSH accessible
+            3. Compare guest boot time before and after reset
+
+        Expected:
+            - Guest boot time after reset does not equal boot time before reset
+        """
+        boot_time_after_reset = get_vm_boot_time(vm=virtctl_reset_vm)
+        assert boot_time_after_reset != boot_time_before_virtctl_reset, (
+            f"Boot time did not change after virtctl reset: "
+            f"before={boot_time_before_virtctl_reset}, after={boot_time_after_reset}"
+        )
+
+
+class TestVMIResetRBAC:
+    """
+    Tests for RBAC enforcement on the VMI reset operation.
+
+    Preconditions:
+        - Running VMI with SSH access
+        - VMI created by unprivileged client (namespace admin)
+    """
+
+    @pytest.mark.polarion("CNV-12379")
+    def test_namespace_admin_can_reset_vmi(
+        self,
+        hard_reset_vm,
+    ):
+        """
+        Test that a namespace admin can perform a VMI reset.
+
+        Steps:
+            1. Perform VMI reset via API using the unprivileged client (namespace admin)
+
+        Expected:
+            - Reset operation succeeds
+        """
+        LOGGER.info(f"Verifying namespace admin can reset VMI {hard_reset_vm.vmi.name}")
+        hard_reset_vm.vmi.reset()
+        wait_for_running_vm(vm=hard_reset_vm, ssh_timeout=TIMEOUT_10MIN)
+
+
+class TestVMIResetOnStoppedVM:
+    """
+    [NEGATIVE] Test for VMI reset on a stopped VM.
+
+    Preconditions:
+        - VM created and then stopped (no running VMI)
+    """
+
+    @pytest.mark.polarion("CNV-12380")
+    def test_reset_fails_on_stopped_vmi(self, stopped_vm):
+        """
+        [NEGATIVE] Test that reset fails on a stopped VMI with an appropriate error.
+
+        Steps:
+            1. Attempt to reset the stopped VM's VMI via API
+
+        Expected:
+            - Reset operation fails with a "not found" error
+        """
+        LOGGER.info(f"Attempting reset on stopped VM {stopped_vm.name}")
+        nonexistent_vmi = VirtualMachineInstance(
+            client=stopped_vm.client,
+            name=stopped_vm.name,
+            namespace=stopped_vm.namespace,
+        )
+        with pytest.raises(ApiException, match="404"):
+            nonexistent_vmi.reset()
+
+
+class TestVMIResetOnNonexistentVMI:
+    """
+    [NEGATIVE] Test for VMI reset on a non-existent VMI.
+
+    Preconditions:
+        - Namespace exists
+    """
+
+    @pytest.mark.polarion("CNV-12381")
+    def test_reset_fails_on_nonexistent_vmi(self, namespace):
+        """
+        [NEGATIVE] Test that reset fails on a non-existent VMI with an appropriate error.
+
+        Steps:
+            1. Attempt to reset a non-existent VMI name via API
+
+        Expected:
+            - Reset operation fails with a "not found" error
+        """
+        nonexistent_vmi = VirtualMachineInstance(
+            client=namespace.client,
+            name="nonexistent-vmi",
+            namespace=namespace.name,
+        )
+        LOGGER.info("Attempting reset on non-existent VMI")
+        with pytest.raises(ApiException, match="404"):
+            nonexistent_vmi.reset()
+
+
+class TestVMIResetOnPausedVM:
+    """
+    Test for VMI reset on a paused VM.
+
+    Note: Per KubeVirt behavior, hard reset succeeds on paused VMIs because
+    it is a hardware-level operation that bypasses guest pause state.
+    The VMI remains paused after reset; an explicit unpause is needed.
+
+    Preconditions:
+        - Running VMI that has been paused
+    """
+
+    @pytest.mark.polarion("CNV-12382")
+    def test_reset_succeeds_on_paused_vmi(self, paused_vm):
+        """
+        Test that reset succeeds on a paused VMI.
+
+        Steps:
+            1. Perform reset on the paused VMI via API
+
+        Expected:
+            - Reset operation succeeds
+        """
+        LOGGER.info(f"Performing reset on paused VMI {paused_vm.vmi.name}")
+        paused_vm.vmi.reset()
