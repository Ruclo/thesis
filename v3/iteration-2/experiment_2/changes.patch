+from utilities.infra import run_virtctl_command
+from utilities.virt import VirtualMachineForTests
+
+
+def take_screenshot(vm: VirtualMachineForTests, screenshot_path: str) -> str:
+    """Take a VNC screenshot of a VM and save it to a file.
+
+    Args:
+        vm: The virtual machine to screenshot.
+        screenshot_path: The file path to save the screenshot to.
+
+    Returns:
+        The path to the saved screenshot file.
+    """
+    command_success, _output, error = run_virtctl_command(
+        command=["vnc", "screenshot", vm.name, "-f", screenshot_path],
+        namespace=vm.namespace,
+        verify_stderr=False,
+    )
+    assert command_success, f"virtctl vnc screenshot failed: {error}"
+    return screenshot_path
