+"""
+VNC Screenshot via libvirt API Tests
+
+STP Reference: https://issues.redhat.com/browse/CNV-61271
+
+This module contains tests verifying that the VMI screenshot endpoint
+uses libvirt's virDomainScreenshot API, eliminating VNC connection
+competition between thumbnail previews and full-screen VNC sessions.
+"""
+
+import logging
+
+import pytest
+from timeout_sampler import TimeoutExpiredError, TimeoutSampler
+
+from tests.os_params import WINDOWS_LATEST
+from tests.virt.screenshot.utils import take_screenshot
+from utilities.constants import TIMEOUT_5MIN
+
+LOGGER = logging.getLogger(__name__)
+
+PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
+SCREENSHOT_INTERVAL = 30
+REPEATED_SCREENSHOT_COUNT = 5
+
+pytestmark = [pytest.mark.arm64, pytest.mark.virt]
+
+
+@pytest.mark.s390x
+class TestScreenshotAPI:
+    """
+    Tests for the VMI screenshot API endpoint functionality.
+
+    Preconditions:
+        - Running Fedora VM with VNC graphics device configured
+        - No active VNC client connections to the VM
+    """
+
+    @pytest.mark.polarion("CNV-61271")
+    def test_screenshot_without_vnc_connection(self, screenshot_fedora_vm, tmp_path):
+        """
+        Test that the screenshot API returns successfully without requiring a VNC connection.
+
+        Steps:
+            1. Call the VMI screenshot command via virtctl
+
+        Expected:
+            - Screenshot command succeeds and produces a non-empty image file
+        """
+        screenshot_file = tmp_path / "screenshot.png"
+        take_screenshot(vm=screenshot_fedora_vm, screenshot_path=str(screenshot_file))
+        file_size = screenshot_file.stat().st_size
+        assert file_size > 0, f"Screenshot file is empty (size={file_size})"
+
+    @pytest.mark.polarion("CNV-61271")
+    def test_screenshot_returns_valid_image(self, screenshot_fedora_vm, tmp_path):
+        """
+        Test that the screenshot API returns a valid PNG image.
+
+        Steps:
+            1. Call the VMI screenshot command via virtctl and save to a file
+
+        Expected:
+            - Saved file starts with a valid PNG signature header
+        """
+        screenshot_file = tmp_path / "screenshot.png"
+        take_screenshot(vm=screenshot_fedora_vm, screenshot_path=str(screenshot_file))
+        with open(screenshot_file, "rb") as file_handle:
+            header = file_handle.read(len(PNG_SIGNATURE))
+        assert header == PNG_SIGNATURE, (
+            f"Screenshot does not have valid PNG header: {header!r}"
+        )
+
+
+@pytest.mark.s390x
+class TestVNCStabilityDuringScreenshot:
+    """
+    Tests for VNC connection stability during concurrent screenshot operations.
+
+    Preconditions:
+        - Running Fedora VM with VNC graphics device configured
+        - Active VNC connection established to the VM via virtctl
+    """
+
+    @pytest.mark.polarion("CNV-61271")
+    def test_vnc_connection_stable_during_screenshot(
+        self, screenshot_fedora_vm, active_vnc_connection, tmp_path
+    ):
+        """
+        Test that a VNC connection remains active when a screenshot is taken concurrently.
+
+        Steps:
+            1. Call the VMI screenshot command via virtctl while VNC connection is active
+
+        Expected:
+            - VNC connection remains open and responsive after the screenshot completes
+        """
+        screenshot_file = tmp_path / "screenshot.png"
+        take_screenshot(vm=screenshot_fedora_vm, screenshot_path=str(screenshot_file))
+        assert active_vnc_connection.isalive(), (
+            "VNC connection dropped after taking a screenshot"
+        )
+
+    @pytest.mark.polarion("CNV-61271")
+    def test_vnc_unaffected_by_repeated_screenshots(
+        self, screenshot_fedora_vm, active_vnc_connection, tmp_path
+    ):
+        """
+        Test that a VNC connection is unaffected by multiple consecutive screenshot requests.
+
+        Steps:
+            1. Call the VMI screenshot command via virtctl multiple times in succession
+               while VNC connection is active
+
+        Expected:
+            - VNC connection remains open and responsive after all screenshot requests complete
+        """
+        for iteration in range(REPEATED_SCREENSHOT_COUNT):
+            screenshot_file = tmp_path / f"screenshot_{iteration}.png"
+            LOGGER.info(f"Taking screenshot {iteration + 1}/{REPEATED_SCREENSHOT_COUNT}")
+            take_screenshot(vm=screenshot_fedora_vm, screenshot_path=str(screenshot_file))
+            assert active_vnc_connection.isalive(), (
+                f"VNC connection dropped after screenshot {iteration + 1}"
+            )
+
+
+@pytest.mark.tier3
+@pytest.mark.s390x
+class TestScreenshotExtendedUsage:
+    """
+    Tests for VNC connection stability during extended concurrent screenshot usage.
+
+    Preconditions:
+        - Running Fedora VM with VNC graphics device configured
+        - Active VNC connection established to the VM via virtctl
+    """
+
+    @pytest.mark.polarion("CNV-61271")
+    def test_vnc_stable_during_extended_screenshot_usage(
+        self, screenshot_fedora_vm, active_vnc_connection, tmp_path
+    ):
+        """
+        Test that a VNC connection remains stable during prolonged concurrent screenshot operations.
+
+        Steps:
+            1. Periodically call the VMI screenshot command over an extended duration
+               while VNC connection is active
+
+        Expected:
+            - VNC connection remains open and responsive throughout the entire duration
+        """
+        screenshot_number = 0
+        try:
+            for is_alive in TimeoutSampler(
+                wait_timeout=TIMEOUT_5MIN,
+                sleep=SCREENSHOT_INTERVAL,
+                func=active_vnc_connection.isalive,
+            ):
+                assert is_alive, "VNC connection dropped during extended screenshot usage"
+                screenshot_number += 1
+                LOGGER.info(f"Taking extended screenshot #{screenshot_number}")
+                take_screenshot(
+                    vm=screenshot_fedora_vm,
+                    screenshot_path=str(tmp_path / f"extended_{screenshot_number}.png"),
+                )
+        except TimeoutExpiredError:
+            LOGGER.info(
+                f"Extended screenshot test completed after {screenshot_number} screenshots"
+            )
+
+
+@pytest.mark.tier3
+@pytest.mark.s390x
+class TestScreenshotRhelGuest:
+    """
+    Tests for screenshot functionality with RHEL guest operating system.
+
+    Preconditions:
+        - Running RHEL VM with VNC graphics device configured
+    """
+
+    @pytest.mark.polarion("CNV-61271")
+    def test_screenshot_with_rhel_guest(self, screenshot_rhel_vm, tmp_path):
+        """
+        Test that the screenshot API returns a valid image for a RHEL guest.
+
+        Steps:
+            1. Call the VMI screenshot command via virtctl
+
+        Expected:
+            - Screenshot command succeeds and produces a non-empty image file
+        """
+        screenshot_file = tmp_path / "rhel_screenshot.png"
+        take_screenshot(vm=screenshot_rhel_vm, screenshot_path=str(screenshot_file))
+        file_size = screenshot_file.stat().st_size
+        assert file_size > 0, f"RHEL screenshot file is empty (size={file_size})"
+
+
+@pytest.mark.tier3
+@pytest.mark.high_resource_vm
+@pytest.mark.parametrize(
+    "golden_image_data_source_for_test_scope_class",
+    [pytest.param({"os_dict": WINDOWS_LATEST})],
+    indirect=True,
+)
+class TestScreenshotWindowsGuest:
+    """
+    Tests for screenshot functionality with Windows guest operating system.
+
+    Preconditions:
+        - Running Windows VM with VNC graphics device configured
+    """
+
+    @pytest.mark.polarion("CNV-61271")
+    def test_screenshot_with_windows_guest(self, screenshot_windows_vm, tmp_path):
+        """
+        Test that the screenshot API returns a valid image for a Windows guest.
+
+        Steps:
+            1. Call the VMI screenshot command via virtctl
+
+        Expected:
+            - Screenshot command succeeds and produces a non-empty image file
+        """
+        screenshot_file = tmp_path / "windows_screenshot.png"
+        take_screenshot(vm=screenshot_windows_vm, screenshot_path=str(screenshot_file))
+        file_size = screenshot_file.stat().st_size
+        assert file_size > 0, f"Windows screenshot file is empty (size={file_size})"

