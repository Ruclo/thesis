+# -*- coding: utf-8 -*-
+
+"""
+VM Snapshot Restore with runStrategy Tests
+
+STP Reference: /home/fedora/thesis/stps/4.md
+Jira: https://issues.redhat.com/browse/CNV-63819
+
+This module contains tests verifying that VM snapshot restore completes
+successfully across all run strategies, with focus on the RerunOnFailure
+strategy fix (CNV-63819). Previously, virt-controller would immediately
+attempt to start the VM during restore, blocking the restore operation.
+"""
+
+import logging
+import shlex
+
+import pytest
+from ocp_resources.virtual_machine import VirtualMachine
+from ocp_resources.virtual_machine_instance import VirtualMachineInstance
+from ocp_resources.virtual_machine_restore import VirtualMachineRestore
+from pyhelper_utils.shell import run_ssh_commands
+from timeout_sampler import TimeoutSampler
+
+from utilities.constants import TIMEOUT_5MIN, TIMEOUT_5SEC, TIMEOUT_10MIN
+from utilities.virt import running_vm
+
+LOGGER = logging.getLogger(__name__)
+
+
+pytestmark = pytest.mark.usefixtures(
+    "namespace",
+    "skip_if_no_storage_class_for_snapshot",
+)
+
+
+class TestSnapshotRestoreRerunOnFailure:
+    """
+    Tests for VM snapshot restore with runStrategy: RerunOnFailure.
+
+    Verifies the fix for CNV-63819 where snapshot restore would get stuck
+    because virt-controller immediately tried to start the VM, blocking
+    the restore operation.
+    """
+
+    @pytest.mark.gating()
+    @pytest.mark.jira("CNV-63819")
+    def test_restore_completes(
+        self,
+        admin_client,
+        rerun_on_failure_vm_with_snapshot,
+    ):
+        """
+        Test that snapshot restore completes for a VM with runStrategy RerunOnFailure.
+
+        Steps:
+            1. Create VirtualMachineRestore from snapshot and wait for completion
+
+        Expected:
+            - VirtualMachineRestore status is "Complete"
+        """
+        vm_for_test, snapshot = rerun_on_failure_vm_with_snapshot
+        LOGGER.info(f"Restoring VM {vm_for_test.name} from snapshot {snapshot.name}")
+        with VirtualMachineRestore(
+            client=admin_client,
+            name=f"restore-{vm_for_test.name}",
+            namespace=vm_for_test.namespace,
+            vm_name=vm_for_test.name,
+            snapshot_name=snapshot.name,
+        ) as vm_restore:
+            vm_restore.wait_restore_done(timeout=TIMEOUT_10MIN)
+            assert vm_restore.instance.status.complete, (
+                f"VirtualMachineRestore {vm_restore.name} did not reach Complete status"
+            )
+
+    @pytest.mark.gating()
+    @pytest.mark.jira("CNV-63819")
+    def test_vm_not_auto_started_during_restore(
+        self,
+        admin_client,
+        rerun_on_failure_vm_with_snapshot,
+    ):
+        """
+        Test that VM does not auto-start during snapshot restore with RerunOnFailure.
+
+        Steps:
+            1. Create VirtualMachineRestore from snapshot
+            2. While restore is in progress, check for VirtualMachineInstance existence
+
+        Expected:
+            - No VirtualMachineInstance exists for the VM during restore
+        """
+        vm_for_test, snapshot = rerun_on_failure_vm_with_snapshot
+        LOGGER.info(f"Restoring VM {vm_for_test.name} and checking no VMI is auto-started")
+        with VirtualMachineRestore(
+            client=admin_client,
+            name=f"restore-autostart-{vm_for_test.name}",
+            namespace=vm_for_test.namespace,
+            vm_name=vm_for_test.name,
+            snapshot_name=snapshot.name,
+        ) as vm_restore:
+            for sample in TimeoutSampler(
+                wait_timeout=TIMEOUT_5MIN,
+                sleep=TIMEOUT_5SEC,
+                func=lambda: vm_restore.instance.get("status", {}).get("complete"),
+            ):
+                vmi = VirtualMachineInstance(
+                    client=admin_client,
+                    name=vm_for_test.name,
+                    namespace=vm_for_test.namespace,
+                )
+                assert not vmi.exists, (
+                    f"VMI {vm_for_test.name} was auto-started during restore with RerunOnFailure strategy"
+                )
+                if sample:
+                    break
+
+    @pytest.mark.gating()
+    @pytest.mark.jira("CNV-63819")
+    def test_vm_starts_after_restore(
+        self,
+        admin_client,
+        rerun_on_failure_vm_with_snapshot,
+    ):
+        """
+        Test that a VM with RerunOnFailure can be started after snapshot restore.
+
+        Preconditions:
+            - VirtualMachineRestore completed successfully
+
+        Steps:
+            1. Start the VM manually and wait for it to reach Running state
+
+        Expected:
+            - VM is "Running" and SSH accessible
+        """
+        vm_for_test, snapshot = rerun_on_failure_vm_with_snapshot
+        LOGGER.info(f"Restoring and starting VM {vm_for_test.name}")
+        with VirtualMachineRestore(
+            client=admin_client,
+            name=f"restore-start-{vm_for_test.name}",
+            namespace=vm_for_test.namespace,
+            vm_name=vm_for_test.name,
+            snapshot_name=snapshot.name,
+        ) as vm_restore:
+            vm_restore.wait_restore_done(timeout=TIMEOUT_10MIN)
+            running_vm(vm=vm_for_test, ssh_timeout=TIMEOUT_10MIN)
+            assert vm_for_test.ready, f"VM {vm_for_test.name} is not Running after restore"
+            vm_for_test.stop(wait=True)
+
+
+@pytest.mark.parametrize(
+    "run_strategy_vm_with_snapshot",
+    [
+        pytest.param(VirtualMachine.RunStrategy.ALWAYS, id="always"),
+        pytest.param(VirtualMachine.RunStrategy.MANUAL, id="manual"),
+        pytest.param(VirtualMachine.RunStrategy.HALTED, id="halted"),
+    ],
+    indirect=True,
+)
+class TestSnapshotRestoreRunStrategies:
+    """
+    Regression tests for snapshot restore across run strategies.
+
+    Verifies that snapshot restore continues to work for all run strategies
+    after the RerunOnFailure fix (CNV-63819).
+    """
+
+    @pytest.mark.jira("CNV-63819")
+    def test_restore_completes(
+        self,
+        admin_client,
+        run_strategy_vm_with_snapshot,
+    ):
+        """
+        Test that snapshot restore completes for a VM with the given run strategy.
+
+        Steps:
+            1. Create VirtualMachineRestore from snapshot and wait for completion
+
+        Expected:
+            - VirtualMachineRestore status is "Complete"
+        """
+        vm_for_test, snapshot = run_strategy_vm_with_snapshot
+        LOGGER.info(f"Restoring VM {vm_for_test.name} from snapshot {snapshot.name}")
+        with VirtualMachineRestore(
+            client=admin_client,
+            name=f"restore-{vm_for_test.name}",
+            namespace=vm_for_test.namespace,
+            vm_name=vm_for_test.name,
+            snapshot_name=snapshot.name,
+        ) as vm_restore:
+            vm_restore.wait_restore_done(timeout=TIMEOUT_10MIN)
+            assert vm_restore.instance.status.complete, (
+                f"VirtualMachineRestore {vm_restore.name} did not reach Complete status"
+            )
+
+    @pytest.mark.jira("CNV-63819")
+    def test_vm_starts_after_restore(
+        self,
+        admin_client,
+        run_strategy_vm_with_snapshot,
+    ):
+        """
+        Test that a VM can be started after snapshot restore with the given run strategy.
+
+        Preconditions:
+            - VirtualMachineRestore completed successfully
+
+        Steps:
+            1. Start the VM manually and wait for it to reach Running state
+
+        Expected:
+            - VM is "Running"
+        """
+        vm_for_test, snapshot = run_strategy_vm_with_snapshot
+        LOGGER.info(f"Restoring and starting VM {vm_for_test.name}")
+        with VirtualMachineRestore(
+            client=admin_client,
+            name=f"restore-start-{vm_for_test.name}",
+            namespace=vm_for_test.namespace,
+            vm_name=vm_for_test.name,
+            snapshot_name=snapshot.name,
+        ) as vm_restore:
+            vm_restore.wait_restore_done(timeout=TIMEOUT_10MIN)
+            running_vm(vm=vm_for_test, ssh_timeout=TIMEOUT_10MIN)
+            assert vm_for_test.ready, f"VM {vm_for_test.name} is not Running after restore"
+            vm_for_test.stop(wait=True)
+
+
+class TestSnapshotRestoreDataIntegrity:
+    """
+    End-to-end tests for snapshot restore data integrity with RerunOnFailure.
+
+    Validates that snapshot restore correctly preserves pre-snapshot data
+    and removes post-snapshot data.
+    """
+
+    @pytest.mark.jira("CNV-63819")
+    def test_preserves_pre_snapshot_data(
+        self,
+        data_integrity_restored_vm,
+    ):
+        """
+        Test that files created before a snapshot are preserved after restore.
+
+        Steps:
+            1. Read file original.txt from the restored VM
+
+        Expected:
+            - File content equals "data-before-snapshot"
+        """
+        LOGGER.info(f"Checking pre-snapshot file content on VM {data_integrity_restored_vm.name}")
+        result = run_ssh_commands(
+            host=data_integrity_restored_vm.ssh_exec,
+            commands=shlex.split("cat original.txt"),
+        )
+        file_content = result[0].strip()
+        assert file_content == "data-before-snapshot", (
+            f"Pre-snapshot file content '{file_content}' does not equal 'data-before-snapshot'"
+        )
+
+    @pytest.mark.jira("CNV-63819")
+    def test_removes_post_snapshot_data(
+        self,
+        data_integrity_restored_vm,
+    ):
+        """
+        Test that files created after a snapshot are removed after restore.
+
+        Steps:
+            1. Check if file after.txt exists on the restored VM
+
+        Expected:
+            - File after.txt does NOT exist
+        """
+        LOGGER.info(f"Checking post-snapshot file absence on VM {data_integrity_restored_vm.name}")
+        result = run_ssh_commands(
+            host=data_integrity_restored_vm.ssh_exec,
+            commands=shlex.split("test -f after.txt && echo exists || echo missing"),
+        )
+        assert result[0].strip() == "missing", (
+            "File after.txt should NOT exist after restore but was found"
+        )
+
+
+class TestMultipleSnapshotRestore:
